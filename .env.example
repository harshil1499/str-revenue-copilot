# Copy to private/.env and fill in. Never commit real values.
# The optimizer reads credentials from the environment only.

OWNERREZ_EMAIL=you@example.com
OWNERREZ_PAT=your_ownerrez_personal_access_token
PRICELABS_API_KEY=your_pricelabs_api_key

# Optional — enables the daily summary email. Omit to skip sending.
GMAIL_APP_PASSWORD=your_gmail_app_password

# Optional — where the append-only decision log lives (defaults to ./private/interventions.jsonl)
# INTERVENTION_LOG=/path/to/interventions.jsonl
